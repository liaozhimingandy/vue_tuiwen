components.d.ts

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量文件（保护敏感信息）
.env.development
!.env.production
!.env.example # 但保留示例

# 临时文件
*.DS_Store
*.local

public/endpoints.json