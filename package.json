    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{ts,mjs}\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{ts,mjs}\" index.html vite.config.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "^0.80.0",
