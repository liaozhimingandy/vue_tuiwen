    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.18.1",
    "c-scrollbar": "^1.0.2",
    "dayjs": "^1.11.21",
    "js-md5": "^0.8.3",
    "lodash": "^4.18.1",
    "motion-v": "^2.4.4",
    "nprogress": "^0.2.0",
    "ogl": "^1.0.11",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "tdesign-vue-next": "^1.20.6",
