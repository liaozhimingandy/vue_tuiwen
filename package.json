    "prettier": "^3.9.7",
    "typescript": "~5.6.2",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^2.2.0"
