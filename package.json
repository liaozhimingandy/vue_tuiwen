  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:only": "vite build",
    "preview": "npm run build && vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
